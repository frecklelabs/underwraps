{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>frecklelabs/k8s//.renovate/labels.json5",
    "github>frecklelabs/k8s//.renovate/semanticCommits.json5",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/Chicago)"
  ],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "mise": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchFileNames": [
        ".github/**"
      ],
      "reviewers": [
        "nicolerenee"
      ]
    },
    {
      "matchManagers": [
        "mise"
      ],
      "semanticCommitScope": "toolchain",
      "commitMessageTopic": "{{depName}}"
    }
  ]
}
